<Page
    x:Class="Thanos.App.Pages.ScanFoldersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Thanos.App.ViewModels"
    Loaded="Page_Loaded" Unloaded="Page_Unloaded">
    <Grid Padding="32,24,32,32" RowSpacing="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnDefinitions="*,Auto,Auto">
            <StackPanel>
                <TextBlock Text="Scan Folders" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Choose the folders Thanos indexes locally." Opacity="0.66" Margin="0,5,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Add folder" Click="AddFolder_Click" Margin="0,0,10,0" />
            <Button Grid.Column="2" Content="Scan included folders" Click="ScanAll_Click" Background="{StaticResource ThanosBlue}" Foreground="White" />
        </Grid>
        <InfoBar x:Name="StatusBar" Grid.Row="1" IsOpen="False" IsClosable="True" />
        <ListView x:Name="FolderList" Grid.Row="2" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:FolderRowViewModel">
                    <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                            <ToggleSwitch IsOn="{x:Bind IsEnabled, Mode=TwoWay}" Toggled="FolderState_Changed" Tag="{x:Bind}" />
                            <StackPanel Grid.Column="1" Spacing="5">
                                <TextBlock Text="{x:Bind FullPath}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <TextBlock Text="{x:Bind PhotoCountText}" Opacity="0.65" />
                                    <TextBlock Text="{x:Bind LastScannedText}" Opacity="0.65" />
                                    <CheckBox Content="Include subfolders" IsChecked="{x:Bind IncludeSubfolders, Mode=TwoWay}" Click="FolderState_Changed" Tag="{x:Bind}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                <Button Content="Rescan" Click="Rescan_Click" Tag="{x:Bind}" IsEnabled="{x:Bind IsEnabled}" />
                                <Button Content="Remove" Click="Remove_Click" Tag="{x:Bind}" Foreground="{StaticResource ThanosRed}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Visibility="Collapsed" x:Name="ProgressPanel">
            <StackPanel>
                <TextBlock x:Name="ProgressText" />
                <ProgressBar x:Name="ScanProgress" Margin="0,8,20,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Cancel" Click="Cancel_Click" />
        </Grid>
    </Grid>
</Page>
