<Page
    x:Class="Thanos.App.Pages.SimilarToSelectedPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Thanos.App.ViewModels" Unloaded="Page_Unloaded">
    <Grid Padding="32,24,32,32" RowSpacing="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
                <TextBlock Text="Similar to Selected" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Compare one reference photo against selected folders using the local vision model." Opacity="0.66" Margin="0,5,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Content="Delete selected" Click="DeleteSelected_Click" Style="{StaticResource DangerButtonStyle}" />
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource PanelStyle}">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="12" ColumnSpacing="12">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Choose reference photo" Click="ChooseReference_Click" />
                    <TextBlock x:Name="ReferencePathText" Text="No photo selected" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Border Background="#E8F5E9" CornerRadius="10" Padding="9,3"><TextBlock Text="Protected" Foreground="#187A2F" FontSize="12" /></Border>
                </StackPanel>
                <Button Grid.Column="1" Content="Add search folder" Click="AddFolder_Click" />
                <ListView x:Name="SearchFolders" Grid.Row="1" Grid.ColumnSpan="2" MaxHeight="100" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,Auto" Padding="4">
                                <TextBlock Text="{Binding FullPath}" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Content="Remove" Click="RemoveFolder_Click" Tag="{Binding}" Padding="8,2" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
        <GridView x:Name="ResultsGrid" Grid.Row="2" SelectionMode="None" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid ItemWidth="230" ItemHeight="275" /></ItemsPanelTemplate></GridView.ItemsPanel>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:SearchResultViewModel">
                    <Border Width="220" Height="265" CornerRadius="9" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid RowDefinitions="205,Auto,*">
                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="8,6,8,0">
                                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind SimilarityText}" VerticalAlignment="Center" Foreground="{StaticResource ThanosBlue}" />
                            </Grid>
                            <TextBlock Grid.Row="2" Text="{x:Bind FullPath}" TextTrimming="CharacterEllipsis" Margin="8,0,8,7" FontSize="11" Opacity="0.58" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel>
                <TextBlock x:Name="ResultSummary" Text="Choose a reference and at least one folder." Opacity="0.68" />
                <ProgressBar x:Name="SearchProgress" IsIndeterminate="True" Visibility="Collapsed" Margin="0,8,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="CancelButton" Content="Cancel" Click="Cancel_Click" Visibility="Collapsed" />
                <Button x:Name="FindButton" Content="Find Similar Photos" Click="Find_Click" Background="{StaticResource ThanosBlue}" Foreground="White" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
