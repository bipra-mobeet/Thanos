<ContentDialog
    x:Class="Thanos.App.Dialogs.FolderPreviewDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Thanos.App.ViewModels"
    Title="Preview folder"
    PrimaryButtonText="Use This Folder"
    SecondaryButtonText="Browse Again"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    Opened="Dialog_Opened">
    <Grid Width="760" Height="510" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <TextBlock x:Name="FolderPathText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                   ToolTipService.ToolTip="{x:Bind FolderPath}" />
        <StackPanel Grid.Row="1" Spacing="3">
            <TextBlock x:Name="SummaryText" Foreground="{ThemeResource SecondaryTextBrush}" />
            <TextBlock Text="Preview only—photos cannot be selected here." FontSize="11"
                       Foreground="{ThemeResource SecondaryTextBrush}" />
        </StackPanel>
        <GridView x:Name="ContentGrid" Grid.Row="2" SelectionMode="None"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate><ItemsWrapGrid ItemWidth="142" ItemHeight="130" /></ItemsPanelTemplate>
            </GridView.ItemsPanel>
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,8,8" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:FolderPreviewItemViewModel">
                    <Border Width="134" Height="122" CornerRadius="8" Background="{ThemeResource SubtleSurfaceBrush}"
                            BorderBrush="{ThemeResource StrokeBrush}" BorderThickness="1">
                        <Grid RowDefinitions="88,*">
                            <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill"
                                   Visibility="{x:Bind PhotoVisibility}" />
                            <FontIcon Glyph="&#xE8B7;" FontSize="42" Foreground="#E7A921"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Visibility="{x:Bind FolderVisibility}" />
                            <TextBlock Grid.Row="1" Text="{x:Bind Name}" Margin="7,4" FontSize="11"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</ContentDialog>
