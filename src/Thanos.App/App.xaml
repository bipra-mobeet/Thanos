<Application
    x:Class="Thanos.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="WorkspaceBrush" Color="#F8FBFF" />
                    <SolidColorBrush x:Key="SidebarBrush" Color="#F0F7FE" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#F7FAFE" />
                    <SolidColorBrush x:Key="SoftBlueBrush" Color="#E5F1FF" />
                    <SolidColorBrush x:Key="StrokeBrush" Color="#DCE7F3" />
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#111827" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#5C6B82" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#77859A" />
                    <SolidColorBrush x:Key="TitleBarBrush" Color="#F5FAFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="WorkspaceBrush" Color="#0F1722" />
                    <SolidColorBrush x:Key="SidebarBrush" Color="#111C2A" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#182331" />
                    <SolidColorBrush x:Key="SubtleSurfaceBrush" Color="#1D2A3A" />
                    <SolidColorBrush x:Key="SoftBlueBrush" Color="#183A5D" />
                    <SolidColorBrush x:Key="StrokeBrush" Color="#314257" />
                    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F3F6FA" />
                    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#AFC0D4" />
                    <SolidColorBrush x:Key="MutedTextBrush" Color="#8FA2B8" />
                    <SolidColorBrush x:Key="TitleBarBrush" Color="#111C2A" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <SolidColorBrush x:Key="ThanosBlue" Color="#087EF5" />
            <SolidColorBrush x:Key="ThanosBlueDark" Color="#0969DA" />
            <SolidColorBrush x:Key="ThanosRed" Color="#EC252C" />

            <Style x:Key="PanelStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource StrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource ThanosBlue}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="OutlineButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource StrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="Padding" Value="16,9" />
            </Style>

            <Style x:Key="DangerButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource ThanosRed}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="Padding" Value="18,10" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource PrimaryTextBrush}" />
            </Style>

            <Style x:Key="SecondaryTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource SecondaryTextBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
